[Unit]
Description=OmniRoute host-side Docker deployment controller
Documentation=https://github.com/markprovjp/OmniRoute
Wants=network-online.target docker.service
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
Environment=OMNIROUTE_DEPLOY_CONFIG=/etc/omniroute-deploy.env
Environment=DOCKER_CONFIG=/var/lib/omniroute-deploy/docker-config
ExecStart=/usr/bin/flock -n -E 75 /run/lock/omniroute-deploy.lock /usr/bin/node /usr/local/libexec/omniroute-deploy.mjs
SuccessExitStatus=75
TimeoutStartSec=45min
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
RestrictSUIDSGID=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=omniroute-deploy

[Install]
WantedBy=multi-user.target
